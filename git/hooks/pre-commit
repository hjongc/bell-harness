#!/usr/bin/env python3
import codecs
import json
import os
import re
import subprocess
import sys
from pathlib import Path


sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "lib"))
from patterns import SECRET_PATTERNS


HUNK = re.compile(rb"^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@")


def allow_patterns():
    result = subprocess.run(
        ["git", "show", "HEAD:.harness.json"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    config = json.loads(result.stdout) if result.returncode == 0 else {}
    secrets = config.get("secrets", {}) if isinstance(config, dict) else None
    if not isinstance(secrets, dict):
        raise ValueError
    allow = secrets.get("allow", [])
    if not isinstance(allow, list) or not all(isinstance(pattern, str) for pattern in allow):
        raise ValueError
    return [re.compile(pattern) for pattern in allow]


def target_path(header):
    path = header.split(b"\t", 1)[0]
    if path.startswith(b'"') and path.endswith(b'"'):
        path = codecs.escape_decode(path[1:-1])[0]
    if path.startswith(b"b/"):
        return os.fsdecode(path[2:])
    return None


def added_lines():
    diff = subprocess.check_output(
        [
            "git", "-c", "core.quotePath=false", "diff", "--cached", "-U0", "--no-color",
            "--no-ext-diff", "--no-textconv", "--src-prefix=a/", "--dst-prefix=b/",
        ]
    )
    path = number = None
    for line in diff.split(b"\n"):
        if line.startswith(b"diff --git "):
            path = number = None
        elif number is None and line.startswith(b"+++ "):
            path = target_path(line[4:])
        elif hunk := HUNK.match(line):
            number = int(hunk[1])
        elif path is not None and number is not None:
            if line.startswith(b"+"):
                yield path, number, line[1:].decode("utf-8", errors="replace")
                number += 1
            elif line.startswith(b" "):
                number += 1


def chain():
    result = subprocess.run(
        ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode == 0:
        hook = Path(os.fsdecode(result.stdout.removesuffix(b"\n"))) / "hooks" / "pre-commit"
        if hook.is_file() and os.access(hook, os.X_OK) and not hook.samefile(__file__):
            os.execv(hook, [str(hook), *sys.argv[1:]])
    return 0


def main():
    try:
        allow = allow_patterns()
    except (ValueError, re.error, OverflowError):
        print("pre-commit: invalid .harness.json", file=sys.stderr)
        return 1

    found = False
    for path, number, line in added_lines():
        if any(pattern.search(line) for pattern in allow):
            continue
        for kind, pattern in SECRET_PATTERNS:
            for _ in pattern.finditer(line):
                print(f"pre-commit: possible {kind} in {path}:{number}", file=sys.stderr)
                found = True
    return 1 if found else chain()


if __name__ == "__main__":
    raise SystemExit(main())
