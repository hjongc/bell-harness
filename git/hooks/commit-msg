#!/usr/bin/env python3
import os
import subprocess
import sys
from pathlib import Path


sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "lib"))
import commit_message as rules


def read_message(path):
    result = subprocess.run(
        ["git", "config", "--get", "core.commentChar"],
        stdout=subprocess.PIPE,
        text=True,
    )
    return rules.clean_message(path.read_text(encoding="utf-8", errors="replace"), result.stdout.rstrip("\n"))


def reject(reason, expected=rules.EXPECTED_SUBJECT, max_subject=rules.MAX_SUBJECT):
    print(f"commit-msg: {reason}", file=sys.stderr)
    print(f"expected: {expected} (<= {max_subject} chars, no Co-Authored-By)", file=sys.stderr)
    print("example: fix(editorial): keep median labels inside the chart", file=sys.stderr)
    return 1


def chain():
    result = subprocess.run(
        ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode == 0:
        hook = Path(os.fsdecode(result.stdout.removesuffix(b"\n"))) / "hooks" / "commit-msg"
        if hook.is_file() and os.access(hook, os.X_OK) and not hook.samefile(__file__):
            os.execv(hook, [str(hook), *sys.argv[1:]])
    return 0


def main():
    message = read_message(Path(sys.argv[1]))
    subject = rules.subject_of(message)
    if subject.startswith(rules.EXEMPT_PREFIXES):
        return chain()

    result = subprocess.run(
        ["git", "show", "HEAD:.harness.json"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    policy = rules.read_policy(result.stdout if result.returncode == 0 else None)
    reason = rules.rejection(message, subject, policy)
    if reason is None:
        return chain()
    if policy is None:
        return reject(reason)
    return reject(reason, policy.expected, policy.max_subject)


if __name__ == "__main__":
    raise SystemExit(main())
