#!/usr/bin/env python3
"""Report whether this machine (and optionally a project) matches bell-harness.

Usage: bin/doctor [--project <path>] [--discovery]
       bin/doctor --project-only <path> [--instruction-status]
Prints one `PASS|WARN|FAIL <check>: <detail>` line per check; exits 1 when any line is FAIL.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import threading
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))
import commit_message  # noqa: E402
import decisions  # noqa: E402
import harness as h  # noqa: E402


HOOKS = ROOT / "git/hooks"
MCP_SERVERS = (
    ("playwright", "codex mcp add playwright -- npx @playwright/mcp@latest"),
    ("chrome-devtools", "codex mcp add chrome-devtools -- npx chrome-devtools-mcp@latest"),
)
DISCOVERY_TIMEOUT = 90


class Report(object):
    def __init__(self, home):
        self.home = home
        self.failed = False

    def line(self, status, check, detail):
        if status == "FAIL":
            self.failed = True
        print(h.tilde("{} {}: {}".format(status, check, detail), self.home))


def run(command, cwd=None, timeout=60, stderr=subprocess.STDOUT, binary=False):
    try:
        result = subprocess.run(command, cwd=cwd, stdout=subprocess.PIPE, stderr=stderr,
                                stdin=subprocess.DEVNULL, text=not binary, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as error:
        return 1, str(error)
    return result.returncode, result.stdout


# ---------- machine ----------

def check_prerequisites(report):
    for tool in ("git", "python3"):
        report.line("PASS" if h.which(tool) else "FAIL", "prerequisite", tool)
    for key in ("user.name", "user.email"):
        if h.git_global(key):
            report.line("PASS", "git identity", key)
        else:
            report.line("FAIL", "git identity", "{} is not set (git config --global {} ...)".format(key, key))
    for tool in ("claude", "codex"):
        if h.which(tool):
            report.line("PASS", "host", tool)
        else:
            report.line("WARN", "host", "{} not found on PATH".format(tool))


def check_install(report, home, old_roots):
    for link, target in h.desired_links(ROOT, home):
        if h.link_target(link) == target:
            report.line("PASS", "link", str(link))
        else:
            report.line("FAIL", "link", "{} does not point to {} (run {}/bin/setup)".format(link, target, ROOT))
    for entry in h.stale_links(ROOT, home, old_roots):
        report.line("FAIL", "stale link", "{} points to a removed skill (run {}/bin/setup)".format(entry, ROOT))
    claude_md = home / h.CLAUDE_MD
    if h.claude_md_ok(ROOT, home):
        report.line("PASS", "instructions", str(claude_md))
    else:
        report.line("FAIL", "instructions", "{} does not start with {}".format(claude_md, h.claude_md_line(ROOT)))
    hooks = h.git_global(h.HOOKS_KEY)
    if hooks == str(HOOKS):
        report.line("PASS", "git hooks", "core.hooksPath is {}".format(HOOKS))
    else:
        report.line("FAIL", "git hooks", "global core.hooksPath is {!r}, expected {}".format(hooks, HOOKS))
    try:
        settings = h.load_json(home / h.SETTINGS, {}) or {}
    except ValueError as error:
        report.line("FAIL", "settings", "{} is not valid JSON ({})".format(home / h.SETTINGS, error))
        return {}
    missing = h.settings_changes(settings, h.settings_fragment(ROOT))
    if missing:
        keys = sorted({".".join(key) for _, key, _ in missing})
        report.line("FAIL", "settings", "{} lacks {}".format(home / h.SETTINGS, ", ".join(keys)))
    else:
        report.line("PASS", "settings", "{} contains the harness fragment".format(home / h.SETTINGS))
    return settings


def check_leftovers(report, home, settings, old_roots):
    paths, plugins = h.retire_config(ROOT, home)
    leftovers = False
    for item in paths:
        parent = h.symlinked_directory(home, Path(item).parent)
        if parent is not None:
            report.line("WARN", "retired", "{} is skipped (symlinked parent {})".format(home / item, parent))
            leftovers = True
        elif h.exists(home / item) and not h.is_managed(home / item, ROOT, old_roots):
            report.line("WARN", "retired", "{} is still present (run {}/bin/setup)".format(home / item, ROOT))
            leftovers = True
    enabled = [p for p in plugins if p in h.enabled_plugins(settings)]
    for plugin in enabled:
        report.line("WARN", "retired plugin", "{} is enabled (run {}/bin/setup)".format(plugin, ROOT))
    if not leftovers and not enabled:
        report.line("PASS", "retired", "no retired item present")
    unmanaged = h.unmanaged_skills(ROOT, home, old_roots)
    if unmanaged:
        report.line("WARN", "unmanaged skills", ", ".join(str(e) for e in unmanaged))
    else:
        report.line("PASS", "unmanaged skills", "none")
    pinned = h.pinned_models(home)
    for hit in pinned:
        report.line("WARN", "pinned model", hit)
    if not pinned:
        report.line("PASS", "pinned model", "none")
    code, output = run(["git", "-C", str(ROOT), "status", "--porcelain"])
    if code == 0 and output.strip():
        report.line("WARN", "harness repo", "{} has uncommitted changes".format(ROOT))
    elif code == 0:
        report.line("PASS", "harness repo", "clean")
    code, output = run(["git", "-C", str(ROOT), "branch", "--show-current"])
    branch = output.strip()
    if code == 0 and branch == "main":
        report.line("PASS", "harness branch", branch)
    elif code == 0:
        report.line("WARN", "harness branch", "{} is on {}; links into it follow that branch".format(ROOT, branch or "a detached HEAD"))
    if h.which("codex"):
        code, output = run(["codex", "mcp", "list"])
        names = {line.split()[0] for line in output.splitlines() if line.split()}
        for name, command in MCP_SERVERS:
            if code == 0 and name in names:
                report.line("PASS", "codex mcp", name)
            else:
                report.line("WARN", "codex mcp", "{} missing; add it with: {}".format(name, command))


# ---------- project ----------

def template_headings():
    text = (ROOT / "templates/AGENTS.md").read_text(encoding="utf-8")
    return [line for line in text.splitlines() if line.startswith("## ")]


def check_sources_table(report, project, lines):
    in_section = False
    paths = set()
    pattern_tops = set()
    sha = ""
    for line in lines:
        line = line.strip()
        if re.match(r"#{1,2} ", line):
            in_section = line == "## Sources of truth"
        if not in_section:
            continue
        if line.startswith("Checked at "):
            sha = line[len("Checked at "):]
        columns = re.split(r"(?<!\\)\|", line.strip("|"))
        if len(columns) < 3:
            continue
        row, look_at = columns[:2]
        tokens = re.findall(r"`([^`]+)`", look_at)
        for target in re.findall(r"\[[^\]]*\]\(([^)]*)\)", look_at):
            target = target.split("#", 1)[0]
            if target and not target.lower().startswith(("http:", "https:", "mailto:")):
                tokens.append(target)
        for token in tokens:
            if any(char in token for char in "<>*"):
                # A pattern such as skills/<name>/SKILL.md cannot be checked, but it covers its folder.
                first = token.split("/", 1)[0]
                if "/" in token and not any(char in first for char in "<>*"):
                    pattern_tops.add(Path(first))
                continue
            token = token.replace(r"\|", "|")
            path = Path(token)
            paths.add(path)
            if not (project / path).exists():
                report.line("WARN", "stale table", '{} (row "{}")'.format(token, row.strip()))

    if not sha:
        report.line("WARN", "table check", "no Checked at line (run the map skill)")
        return
    git = ["git", "-C", str(project)]
    code, commit = run(git + ["rev-parse", "--verify", "--end-of-options", sha + "^{commit}"])
    if code != 0:
        report.line("WARN", "table check", "unknown commit " + sha)
        return
    # The commit that wrote this marker usually also updated table paths; count changes after it.
    code, marker = run(git + ["log", "-1", "--no-show-signature", "--no-ext-diff", "--no-textconv",
                              "--format=%H", "-S", "Checked at " + sha, "--", "AGENTS.md"])
    base = marker.strip() if code == 0 and marker.strip() else commit.strip()
    # Ordinary edits under a row do not make the table stale; removed or renamed files under a row,
    # and new top-level folders that no row covers, do.
    code, output = run(git + ["diff", "--no-ext-diff", "--no-textconv", "--name-status",
                              "--no-renames", "-z", base + "..HEAD"])
    if code != 0:
        report.line("WARN", "table check", "could not compare HEAD with " + sha)
        return
    fields = output.split("\0")
    tops = {Path(path.parts[0]) for path in paths if path.parts} | pattern_tops  # a row inside a folder covers it
    removed, added = [], []
    for status, name in zip(fields[0::2], fields[1::2]):
        path = Path(name)
        covered = path in paths or any(parent in paths for parent in path.parents)
        if status.startswith("D") and covered:
            removed.append(name)
        elif status.startswith("A") and len(path.parts) > 1 and not covered:
            top = Path(path.parts[0])
            if top not in tops and not top.name.startswith(".") and str(top) not in added:
                added.append(str(top))
    if removed or added:
        problems = ["removed under a row: " + ", ".join(removed[:5])] if removed else []
        problems += ["new folder without a row: " + ", ".join(added[:5])] if added else []
        report.line("WARN", "table check", "since {}: {}; rerun the map skill".format(sha, "; ".join(problems)))
    else:
        report.line("PASS", "table check", "table still matches the tree since " + sha)


def check_project(report, project):
    if not project.is_dir():
        report.line("FAIL", "project", "{} is not a directory".format(project))
        return
    agents = project / "AGENTS.md"
    if agents.is_file():
        lines = agents.read_text(encoding="utf-8").splitlines()
        missing = [heading for heading in template_headings() if heading not in lines]
        for heading in missing:
            report.line("WARN", "project AGENTS.md", "missing heading {!r}".format(heading))
        if not missing:
            report.line("PASS", "project AGENTS.md", "has the template headings")
        template = (ROOT / "templates/AGENTS.md").read_text(encoding="utf-8")
        text = agents.read_text(encoding="utf-8")
        unfilled = sorted({mark for mark in re.findall(r"<[A-Z][^<>\n]{3,}>", template) if mark in text})
        if unfilled:
            report.line("WARN", "project AGENTS.md", "{} template placeholder(s) not filled in, for example {}".format(
                len(unfilled), unfilled[0]))
        check_sources_table(report, project, lines)
    else:
        report.line("WARN", "project AGENTS.md", "{} not found (start from {}/templates/AGENTS.md)".format(agents, ROOT))

    claude = project / "CLAUDE.md"
    if claude.is_file():
        lines = [line for line in claude.read_text(encoding="utf-8").splitlines() if line.strip()]
        if lines and lines[0].strip() == "@AGENTS.md":
            report.line("PASS", "project CLAUDE.md", "imports AGENTS.md")
        else:
            report.line("WARN", "project CLAUDE.md", "first line is not @AGENTS.md")

    config = project / ".harness.json"
    if config.is_file():
        try:
            json.loads(config.read_text(encoding="utf-8"))
            report.line("PASS", "project .harness.json", "parses")
        except ValueError as error:
            report.line("FAIL", "project .harness.json", "does not parse ({})".format(error))

    code, output = run(["git", "-C", str(project), "config", "--local", "--get", h.HOOKS_KEY])
    if code == 0 and output.strip():
        report.line("WARN", "project hooks", "repo-local core.hooksPath {} bypasses the harness hooks".format(
            output.strip()))

    check_commits(report, project)

    problems = decisions.check(project)
    for problem in problems:
        report.line("WARN", "stale decision", problem)
    if not problems:
        report.line("PASS", "decisions", "records valid")
    for path, count in decisions.legacy(project):
        report.line("WARN", "legacy decisions",
                    '{} has {} decision-like line(s) outside "## Decisions" (run the map skill to migrate)'.format(
                        path, count))


def check_instruction_status(report, project):
    git = ["git", "--no-optional-locks", "-C", str(project)]
    code, root = run(git + ["rev-parse", "--show-toplevel"], stderr=subprocess.DEVNULL, binary=True)
    if code != 0 or Path(os.fsdecode(root.removesuffix(b"\n"))).resolve() != project:
        report.line("WARN", "instruction status", "use the root of a Git checkout")
        return

    # A status query should not invoke a configured fsmonitor hook.
    code, output = run(git + ["-c", "core.fsmonitor=false", "status", "--porcelain=v1", "-z",
                              "--untracked-files=all", "--no-renames", "--ignore-submodules=all", "--",
                              ":(top,glob)**/AGENTS.md", ":(top,glob)**/CLAUDE.md"],
                       stderr=subprocess.DEVNULL, binary=True)
    if code != 0:
        report.line("WARN", "instruction status", "could not read Git status")
        return

    entries = sorted((os.fsdecode(record[3:]), record[:2].decode("ascii"))
                     for record in output.split(b"\0") if record)
    for path, status in entries:
        if status == "??":
            report.line("WARN", "untracked instruction", repr(path))
        else:
            index, worktree = status.replace(" ", ".")
            report.line("WARN", "uncommitted instruction",
                        "{!r} (index={}, worktree={})".format(path, index, worktree))
    if not entries:
        report.line("PASS", "instruction status", "no uncommitted instructions")


def check_commits(report, project):
    git = ["git", "-C", str(project)]
    code, _ = run(git + ["rev-parse", "--verify", "-q", "HEAD"])
    if code != 0:
        return
    code, _ = run(git + ["rev-parse", "--abbrev-ref", "@{u}"])
    revs = ["@{u}..HEAD"] if code == 0 else ["-n", "20", "HEAD"]
    log = ["log", "--no-show-signature", "--no-notes", "--no-decorate",
           "--encoding=UTF-8", "--format=%H%x00%B", "-z"]
    code, output = run(git + log + revs, stderr=subprocess.DEVNULL, binary=True)
    if code != 0:
        report.line("WARN", "commit messages", "could not read recent commits")
        return
    if not output:
        report.line("PASS", "commit messages", "recent commits follow the rules")
        return

    code, config = run(git + ["show", "HEAD:.harness.json"], stderr=subprocess.DEVNULL, binary=True)
    policy = commit_message.read_policy(config if code == 0 else None)
    _, comment = run(git + ["config", "--get", "core.commentChar"], stderr=subprocess.DEVNULL)
    fields = output.decode("utf-8", errors="replace").split("\0")
    rejected = []
    for sha, body in zip(fields[0::2], fields[1::2]):
        message = commit_message.clean_message(body, comment.rstrip("\n"))
        if commit_message.rejection(message, commit_message.subject_of(message), policy):
            rejected.append(sha[:7])
    if rejected:
        report.line("WARN", "commit messages", "rejected by the harness hook: {}".format(" ".join(rejected)))
    else:
        report.line("PASS", "commit messages", "recent commits follow the rules")


# ---------- discovery ----------

def claude_init_skills():
    """Skill names from the first system/init event of a Claude session, or None."""
    with tempfile.TemporaryDirectory() as folder:
        process = subprocess.Popen(
            ["claude", "-p", "Reply OK", "--output-format", "stream-json", "--verbose", "--max-turns", "1"],
            cwd=folder, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            universal_newlines=True)
        timer = threading.Timer(DISCOVERY_TIMEOUT, process.kill)
        timer.start()
        try:
            for line in process.stdout:
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                if event.get("type") == "system" and event.get("subtype") == "init":
                    skills = event.get("skills") or []
                    return [s.get("name", "") if isinstance(s, dict) else str(s) for s in skills]
            return None
        finally:
            timer.cancel()
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
            process.stdout.close()


def check_discovery(report, home):
    harness = h.skill_names(ROOT)
    paths, plugins = h.retire_config(ROOT, home)
    retired = h.retired_names(paths)
    prefixes = tuple(h.plugin_prefixes(plugins))

    if h.which("claude"):
        skills = claude_init_skills()
        if skills is None:
            report.line("FAIL", "claude discovery", "no init event from claude -p")
        else:
            problems = ["missing " + n for n in harness if n not in skills]
            problems += ["retired " + n for n in skills if n in retired or n.startswith(prefixes)]
            if problems:
                report.line("FAIL", "claude discovery", ", ".join(problems))
            else:
                report.line("PASS", "claude discovery", "{} harness skills, no retired ones".format(len(harness)))
    else:
        report.line("WARN", "claude discovery", "claude not found on PATH")

    if h.which("codex"):
        code, output = run(["codex", "debug", "prompt-input", "probe"], timeout=DISCOVERY_TIMEOUT)
        if code != 0:
            report.line("FAIL", "codex discovery", "codex debug prompt-input failed")
        else:
            problems = ["missing " + n for n in harness if "/{}/SKILL.md".format(n) not in output]
            problems += ["retired " + n for n in retired if "/{}/SKILL.md".format(n) in output]
            if problems:
                report.line("FAIL", "codex discovery", ", ".join(problems))
            else:
                report.line("PASS", "codex discovery", "{} harness skills, no retired ones".format(len(harness)))
    else:
        report.line("WARN", "codex discovery", "codex not found on PATH")


def main():
    parser = argparse.ArgumentParser(prog="doctor", description="Check this machine against bell-harness.")
    project = parser.add_mutually_exclusive_group()
    project.add_argument("--project", metavar="PATH", help="also check a project repository")
    project.add_argument("--project-only", metavar="PATH", help="check the project without machine checks")
    parser.add_argument("--discovery", action="store_true", help="ask claude and codex which skills they load")
    parser.add_argument("--instruction-status", action="store_true",
                        help="show uncommitted instruction files in a project-only check")
    args = parser.parse_args()
    if args.instruction_status and args.project_only is None:
        parser.error("--instruction-status requires --project-only")
    home = h.home_dir()
    report = Report(home)
    if args.project_only is not None:
        if args.discovery:
            parser.error("--project-only cannot be combined with --discovery")
        if not h.which("git"):
            report.line("FAIL", "prerequisite", "git")
            return 1
        checkout = Path(args.project_only).resolve()
        check_project(report, checkout)
        if args.instruction_status:
            check_instruction_status(report, checkout)
        return 1 if report.failed else 0
    check_prerequisites(report)
    old_roots = set(h.previous_roots(home))
    settings = check_install(report, home, old_roots)
    check_leftovers(report, home, settings, old_roots)
    if args.project:
        check_project(report, Path(args.project).resolve())
    if args.discovery:
        check_discovery(report, home)
    return 1 if report.failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
