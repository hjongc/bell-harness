#!/usr/bin/env python3
"""Install bell-harness into the home directory with a recorded backup, or undo an install.

Usage: bin/setup [--dry-run]
       bin/setup --restore <id>|all [--dry-run]
       bin/setup --list-backups
"""
import argparse
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))
import harness as h  # noqa: E402


HOOKS = ROOT / "git/hooks"


class Abort(Exception):
    pass


def say(text):
    print(h.tilde(text, HOME))


# ---------- preflight ----------

def preflight(old_roots):
    errors, notes = [], []
    if not h.which("git"):
        errors.append("git not found on PATH")
    if not h.which("python3"):
        errors.append("python3 not found on PATH")
    for tool in ("claude", "codex"):
        if not h.which(tool):
            notes.append("{} not found on PATH; its parts are skipped".format(tool))
    if errors:
        return errors, notes
    for key in ("user.name", "user.email"):
        if not h.git_global(key):
            errors.append("global git {} is not set".format(key))
    settings = HOME / h.SETTINGS
    if settings.exists():
        try:
            data = json.loads(settings.read_text(encoding="utf-8"))
            if not isinstance(data, dict):
                errors.append("{} is not a JSON object".format(settings))
        except ValueError as error:
            errors.append("{} is not valid JSON ({})".format(settings, error))
    for folder in h.SKILL_DIRS + (".codex/rules",):
        if (HOME / folder).is_symlink():
            errors.append("{} is a symlink; setup only manages real folders".format(HOME / folder))
    hooks = h.git_global(h.HOOKS_KEY)
    if hooks and Path(hooks) != HOOKS and Path(hooks).parent.parent not in old_roots:
        errors.append("global core.hooksPath is {}, not {}".format(hooks, HOOKS))
    return errors, notes


# ---------- plan ----------

def rel(path):
    return Path(path).relative_to(HOME).as_posix()


def plan(old_roots):
    actions = []
    retire_paths, retire_plugins = h.retire_config(ROOT, HOME)
    for item in retire_paths:
        parent = h.symlinked_directory(HOME, Path(item).parent)
        if parent is not None:
            say("setup: skipped ~/{} (symlinked parent {})".format(item, parent))
            continue
        path = HOME / item
        if h.exists(path) and not h.is_managed(path, ROOT, old_roots):
            actions.append({"action": "retire", "path": item})

    settings = h.load_json(HOME / h.SETTINGS, {}) or {}
    enabled = h.enabled_plugins(settings)
    for plugin in retire_plugins:
        if plugin in enabled:
            if h.which("claude"):
                actions.append({"action": "uninstall-plugin", "path": plugin})
            else:
                say("setup: cannot uninstall {} (claude not found)".format(plugin))

    for link, target in h.desired_links(ROOT, HOME):
        if h.link_target(link) != target:
            actions.append({"action": "link", "path": rel(link), "target": str(target)})
    for entry in h.stale_links(ROOT, HOME, old_roots):
        actions.append({"action": "unlink", "path": rel(entry), "target": str(h.link_target(entry))})

    if not h.claude_md_ok(ROOT, HOME):
        actions.append({"action": "write", "path": h.CLAUDE_MD})
    if h.git_global(h.HOOKS_KEY) != str(HOOKS):
        actions.append({"action": "git-config", "path": h.HOOKS_KEY, "value": str(HOOKS)})

    changes = h.settings_changes(settings, h.settings_fragment(ROOT))
    if changes:
        actions.append({"action": "settings", "path": h.SETTINGS, "changes": changes})
    return actions


def describe(action, old_roots):
    kind, item = action["action"], action["path"]
    if kind == "retire":
        return ["retire ~/{} (moved into the backup)".format(item)]
    if kind == "uninstall-plugin":
        return ["claude plugin uninstall {}".format(item)]
    if kind == "link":
        path = HOME / item
        note = ""
        if h.exists(path) and not h.is_managed(path, ROOT, old_roots):
            note = " (replaces the existing entry)"
        return ["link ~/{} -> {}{}".format(item, action["target"], note)]
    if kind == "unlink":
        return ["unlink ~/{} (skill removed from the harness)".format(item)]
    if kind == "write":
        return ["write ~/{} importing {}".format(item, h.claude_md_line(ROOT)[1:])]
    if kind == "git-config":
        return ["git config --global {} {}".format(item, action["value"])]
    lines = []
    for op, key, value in action["changes"]:
        lines.append("settings ~/{} {} {} {}".format(
            item, op, ".".join(key), json.dumps(value, ensure_ascii=False)))
    return lines


# ---------- apply ----------

def new_backup():
    folder = HOME / h.BACKUPS
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    name, count = stamp, 1
    while h.exists(folder / name) or h.exists(folder / (name + ".restored")):
        name = "{}-{}".format(stamp, count)
        count += 1
    path = folder / name
    path.mkdir(parents=True)
    return path


def stash(item, backup):
    """Move ~/item into the backup; return True when something was moved."""
    source = HOME / item
    if not h.exists(source):
        return False
    destination = backup / "home" / item
    if h.exists(destination):
        raise Abort("backup already holds {}".format(destination))
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(source), str(destination))
    return True


def unstash(item, backup):
    source = backup / "home" / item
    destination = HOME / item
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(source), str(destination))


def record(backup, entry):
    with (backup / "manifest.jsonl").open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(entry, ensure_ascii=False) + "\n")
        stream.flush()
        os.fsync(stream.fileno())


def write_settings(data, expected_hash):
    """Write settings atomically through a symlink; abort when the file changed meanwhile."""
    target = Path(os.path.realpath(str(HOME / h.SETTINGS)))
    target.parent.mkdir(parents=True, exist_ok=True)
    text = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
    handle, temporary = tempfile.mkstemp(dir=str(target.parent), prefix=".settings.", suffix=".tmp")
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o600)
        if h.sha256(target) != expected_hash:
            raise Abort("{} changed while setup ran; run setup again".format(HOME / h.SETTINGS))
        os.replace(temporary, str(target))
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def read_settings():
    target = Path(os.path.realpath(str(HOME / h.SETTINGS)))
    before = h.sha256(target)
    data = json.loads(target.read_text(encoding="utf-8")) if before else {}
    return data, before


def apply_settings():
    data, before = read_settings()
    entries = []
    for op, key, value in h.settings_changes(data, h.settings_fragment(ROOT)):
        if op == "set":
            had, previous = h.get_key(data, key)
            entry = {"op": "set", "key": list(key), "value": value}
            entry.update({"previous": previous} if had else {"absent": True})
            h.set_key(data, key, value)
        else:
            h.get_key(data, key)[1].append(value)
            entry = {"op": "add", "key": list(key), "item": value}
        entries.append(entry)
    if entries:
        write_settings(data, before)
    return entries


def apply(action, backup):
    kind, item = action["action"], action["path"]
    entry = {"action": kind, "path": item}
    if kind == "retire":
        parent = h.symlinked_directory(HOME, Path(item).parent)
        if parent is not None:
            raise Abort("cannot retire ~/{} (symlinked parent {})".format(item, parent))
        stash(item, backup)
        entry["previous"] = "backup"
    elif kind == "uninstall-plugin":
        result = subprocess.run(["claude", "plugin", "uninstall", item],
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                universal_newlines=True)
        if result.returncode != 0:
            raise Abort("claude plugin uninstall {} failed: {}".format(item, result.stdout.strip()))
        entry["previous"] = "enabled"
    elif kind == "link":
        entry["previous"] = "backup" if stash(item, backup) else "absent"
        link = HOME / item
        try:
            link.parent.mkdir(parents=True, exist_ok=True)
            os.symlink(action["target"], str(link))
        except OSError:
            if entry["previous"] == "backup":
                unstash(item, backup)
            raise
        entry["target"] = action["target"]
    elif kind == "unlink":
        stash(item, backup)
        entry.update({"previous": "backup", "target": action["target"]})
    elif kind == "write":
        entry["previous"] = "backup" if stash(item, backup) else "absent"
        path = HOME / item
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(h.claude_md_line(ROOT) + "\n", encoding="utf-8")
        except OSError:
            if h.exists(path):
                os.unlink(str(path))
            if entry["previous"] == "backup":
                unstash(item, backup)
            raise
        entry["hash"] = h.sha256(path)
    elif kind == "git-config":
        previous = h.git_global(item)
        subprocess.run(["git", "config", "--global", item, action["value"]], check=True)
        entry.update({"previous": previous or "absent", "value": action["value"]})
    elif kind == "settings":
        entries = apply_settings()
        if not entries:
            return
        entry["previous"] = entries
    record(backup, entry)


def run_doctor():
    sys.stdout.flush()
    return subprocess.call([sys.executable, str(ROOT / "bin/doctor")])


def install(dry_run):
    old_roots = set(h.previous_roots(HOME))
    errors, notes = preflight(old_roots)
    for note in notes:
        say("setup: note: " + note)
    if errors:
        for error in errors:
            say("setup: " + error)
        return 2
    actions = plan(old_roots)
    if not actions:
        say("setup: nothing to do")
        return 0 if dry_run else run_doctor()
    if dry_run:
        for action in actions:
            for line in describe(action, old_roots):
                say("would " + line)
        return 0
    backup = new_backup()
    done = 0
    try:
        for action in actions:
            lines = describe(action, old_roots)  # describe before applying: it reads the state the action replaces
            apply(action, backup)
            for line in lines:
                say(line)
            done += 1
    except (Abort, OSError, subprocess.CalledProcessError) as error:
        say("setup: stopped after {} of {} actions: {}".format(done, len(actions), error))
        say("setup: finished actions are recorded; undo them with bin/setup --restore {}".format(backup.name))
        return 1
    say("setup: done ({} actions, backup {})".format(len(actions), backup.name))
    return run_doctor()


# ---------- restore ----------

def skipped(item):
    say("restore: skipped {} (changed since setup)".format(item))


def undo_settings(entries, dry_run):
    try:
        data, before = read_settings()
    except ValueError:
        return skipped("~/{} (not valid JSON; fix it and undo the settings by hand)".format(h.SETTINGS))
    changed = False
    for entry in entries:
        key = tuple(entry["key"])
        name = "~/{} {}".format(h.SETTINGS, ".".join(key))
        has, current = h.get_key(data, key)
        if entry["op"] == "set":
            if not has or not h.same(current, entry["value"]):
                skipped(name)
                continue
            if entry.get("absent"):
                h.delete_key(data, key)
            else:
                h.set_key(data, key, entry["previous"])
        else:
            if not (has and isinstance(current, list) and h.contains(current, entry["item"])):
                continue
            current.pop([h.same(x, entry["item"]) for x in current].index(True))
        say("restore: {}settings {}".format("would restore " if dry_run else "", name))
        changed = True
    if changed and not dry_run:
        write_settings(data, before)


KNOWN_ACTIONS = ("retire", "uninstall-plugin", "link", "unlink", "write", "git-config", "settings")


def valid_setting_entry(entry):
    if not isinstance(entry, dict):
        return False
    key = entry.get("key")
    if not isinstance(key, list) or not key or not all(isinstance(part, str) for part in key):
        return False
    if entry.get("op") == "add":
        return "item" in entry
    if entry.get("op") == "set":
        if "absent" in entry:
            return "value" in entry and entry["absent"] is True and "previous" not in entry
        return "value" in entry and "previous" in entry
    return False


def valid_entry(entry):
    if not isinstance(entry, dict) or entry.get("action") not in KNOWN_ACTIONS:
        return False
    kind, item = entry["action"], entry.get("path")
    if not isinstance(item, str):
        return False
    if kind in ("retire", "link", "unlink", "write"):
        parts = Path(item).parts
        if (len(parts) < 2 or Path(item).is_absolute() or ".." in parts
                or parts[0] not in h.MANAGED_ROOTS or any(h.never_touch(p) for p in parts[1:])):
            return False
        if kind in ("link", "write"):
            field = "target" if kind == "link" else "hash"
            return entry.get("previous") in ("backup", "absent") and isinstance(entry.get(field), str)
        return True
    if kind == "git-config":
        return (item == h.HOOKS_KEY and isinstance(entry.get("value"), str)
                and isinstance(entry.get("previous"), str))
    if kind == "settings":
        changes = entry.get("previous")
        return item == h.SETTINGS and isinstance(changes, list) and all(map(valid_setting_entry, changes))
    return True


def undo(entry, backup, dry_run):
    kind, item = entry["action"], entry["path"]
    path = HOME / item
    saved = backup / "home" / item
    prefix = "restore: would undo " if dry_run else "restore: undo "
    if kind == "uninstall-plugin":
        say("restore: reinstall with: claude plugin install {}".format(item))
        return
    if kind == "settings":
        undo_settings(entry["previous"], dry_run)
        return
    if kind == "git-config":
        if h.git_global(item) != entry["value"]:
            return skipped("git config --global " + item)
        say(prefix + "git config --global " + item)
        if not dry_run:
            if entry["previous"] == "absent":
                subprocess.run(["git", "config", "--global", "--unset", item], check=True)
            else:
                subprocess.run(["git", "config", "--global", item, entry["previous"]], check=True)
        return
    if kind in ("link", "write") and not h.exists(path) and entry["previous"] == "backup" \
            and h.exists(saved):
        # An earlier restore removed the installed item but stopped before moving the original back.
        say(prefix + "{} ~/{} (resumed)".format(kind, item))
        if not dry_run:
            unstash(item, backup)
        return
    if kind in ("link", "write"):
        if kind == "link":
            still = h.link_target(path) == Path(entry["target"])
        else:
            still = not path.is_symlink() and h.sha256(path) == entry["hash"]
        if not still or (entry["previous"] == "backup" and not h.exists(saved)):
            return skipped("~/" + item)
        say(prefix + "{} ~/{}".format(kind, item))
        if not dry_run:
            os.unlink(str(path))
            if entry["previous"] == "backup":
                unstash(item, backup)
        return
    # retire and unlink: the original sits in the backup
    if h.exists(path) or not h.exists(saved):
        return skipped("~/" + item)
    say(prefix + "{} ~/{}".format(kind, item))
    if not dry_run:
        unstash(item, backup)


BACKUP_NAME = re.compile(r"^(\d{8}T\d{6}Z)(?:-(\d+))?$")


def backup_order(name):
    stamp, count = BACKUP_NAME.match(name).groups()
    return stamp, int(count or 0)


def read_backup(backup):
    manifest, status = h.backup_manifest(backup)
    if manifest is None:
        return [], status, None
    entries = []
    try:
        with manifest.open("rb") as stream:
            for number, line in enumerate(stream, 1):
                try:
                    line = line.decode("utf-8")
                    if not line.strip():
                        continue
                    entry = json.loads(line)
                except (ValueError, RecursionError):
                    return [], "damaged", number
                if not valid_entry(entry):
                    return [], "damaged", number
                entries.append(entry)
    except OSError:
        return [], "damaged", None
    return entries, "valid", None


def list_backups():
    try:
        directory = list((HOME / h.BACKUPS).iterdir())
    except FileNotFoundError:
        directory = []
    except OSError:
        say("list-backups: cannot read the backup directory")
        return 2

    backups = []
    for backup in directory:
        backup_id = backup.name.removesuffix(".restored")
        if BACKUP_NAME.fullmatch(backup_id):
            state = "active" if backup.name == backup_id else "restored"
            backups.append((backup_id, state, backup))
    if not backups:
        say("list-backups: no backups found")
        return 0

    damaged = False
    for backup_id, state, backup in sorted(backups, key=lambda item: backup_order(item[0]), reverse=True):
        _, status, _ = read_backup(backup)
        say("{} {} {}".format(backup_id, state, status))
        damaged = damaged or status != "valid"
    return 1 if damaged else 0


def restore(name, dry_run):
    folder = HOME / h.BACKUPS
    if name == "all":
        names = sorted((p.name for p in folder.iterdir()
                        if BACKUP_NAME.fullmatch(p.name) and (p.is_symlink() or p.is_dir())),
                       key=backup_order, reverse=True) if folder.is_dir() else []
    elif BACKUP_NAME.fullmatch(name):
        names = [name]
    else:
        say("restore: {!r} is not a backup id (expected <UTC timestamp>[-n] or all)".format(name))
        return 2
    if not names:
        say("restore: no backups to restore")
        return 0
    for backup_name in names:
        backup = folder / backup_name
        entries, status, number = read_backup(backup)
        if status == "unsafe":
            say("restore: backup {} has a symlinked directory or manifest. Nothing was undone".format(backup_name))
            return 2
        if status == "damaged":
            if number is None:
                say("restore: no readable manifest for backup {}".format(backup_name))
            else:
                say("restore: {}:{} is damaged (nothing was undone and the backup is kept)".format(
                    backup / "manifest.jsonl", number))
            return 2
        for entry in entries:
            if entry["action"] == "retire":
                item = Path(entry["path"])
                for path in (item, backup.relative_to(HOME) / "home" / item):
                    parent = h.symlinked_directory(HOME, path.parent)
                    if parent is not None:
                        say("restore: cannot restore ~/{} (symlinked parent {}). The backup is kept".format(
                            item, parent))
                        return 2
        for entry in reversed(entries):
            undo(entry, backup, dry_run)
        if not dry_run:
            backup.rename(folder / (backup_name + ".restored"))
            say("restore: backup {} restored".format(backup_name))
    return 0


def main():
    parser = argparse.ArgumentParser(prog="setup", description="Install or restore bell-harness.")
    parser.add_argument("--dry-run", action="store_true", help="print the plan and change nothing")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--restore", metavar="ID|all", help="undo the actions of a backup")
    mode.add_argument("--list-backups", action="store_true", help="list backup IDs and validate their manifests")
    args = parser.parse_args()
    if args.list_backups and args.dry_run:
        parser.error("--list-backups cannot be combined with --dry-run")
    linked = h.symlinked_directory(HOME, h.BACKUPS)
    if linked is not None:
        command = "list-backups" if args.list_backups else ("restore" if args.restore else "setup")
        say("{}: backup directory {} traverses symlink {}".format(command, HOME / h.BACKUPS, linked))
        return 2
    if args.list_backups:
        return list_backups()
    if args.restore:
        return restore(args.restore, args.dry_run)
    return install(args.dry_run)


HOME = h.home_dir()

if __name__ == "__main__":
    raise SystemExit(main())
